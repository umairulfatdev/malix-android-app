{
  "expo": {
    "name": "MALIX",
    "slug": "malix-app",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "malix",
    "icon": "./assets/android-icon-foreground.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.malix.app"
    },
    "android": {
      "package": "com.malix.app",
      "minSdkVersion": 24,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0F172A"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      "expo-splash-screen",
      "expo-screen-orientation"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/android-icon-foreground.png"
    },
    "updates": {
      "url": "https://u.expo.dev/4be47768-054b-4026-99f8-09b4d266c91b"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4be47768-054b-4026-99f8-09b4d266c91b"
      }
    },
    "owner": "umair37"
  }
}
